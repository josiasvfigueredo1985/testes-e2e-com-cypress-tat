{
  "name": "testes-e2e-com-cypress",
  "version": "1.0.0",
  "description": "Sample project to demonstrate e2e tests written with Cypress running on GitHub Actions",
  "main": "index.js",
  "scripts": {
    "lint": "eslint cypress cypress.config.js eslint.config.js",
    "lint:fix": "eslint cypress cypress.config.js eslint.config.js --fix",
    "cy:open": "cypress open",
    "cy:open:tablet": "cypress open --config viewportWidth=767,viewportHeight=480",
    "test": "cypress run",
    "test:public": "cypress run --expose grepTags=@public,grepFilterSpecs=true,grepOmitFiltered=true",
    "test:tablet": "npm run test:public -- --config viewportWidth=767,viewportHeight=480",
    "test:authenticated": "cypress run --expose grepTags=@authenticated,grepFilterSpecs=true,grepOmitFiltered=true",
    "test:signup": "cypress run --expose grepTags=@signup,grepFilterSpecs=true,grepOmitFiltered=true",
    "test:billing": "cypress run --expose grepTags=@billing,grepFilterSpecs=true,grepOmitFiltered=true"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "keywords": [],
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@faker-js/faker": "^10.6.0",
    "@typescript-eslint/parser": "^8.72.2",
    "cypress": "^16.3.0",
    "cypress-file-upload": "^5.0.8",
    "cypress-iframe": "^1.0.1",
    "cypress-mailosaur": "^5.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-cypress": "^7.0.5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
